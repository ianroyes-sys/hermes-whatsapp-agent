# Hermes reads these from the process environment (e.g. the LaunchAgent's
# EnvironmentVariables, or `export` before `npm start`). All are optional.

# Which local CLI answers: "claude" (default) or "codex".
HERMES_MODEL_BACKEND=
# Absolute path to the Claude Code CLI (default ~/.local/bin/claude).
HERMES_CLAUDE_BIN=
# Absolute path to the Codex CLI (default ~/.npm-global/bin/codex).
HERMES_CODEX_BIN=
# Name used in the assistant's system prompt (default "the owner").
HERMES_OWNER_NAME=
# Extra senders allowed to talk to Hermes: comma-separated numbers with country code,
# digits only. Overrides allowFrom in config.json. Empty = only your own self-chat.
HERMES_ALLOW_FROM=
# Obsidian vault Hermes reads and writes tasks into (default ~/Developer/Ideaverse).
VAULT_PATH=
# Omega dashboard checkout, used for the loop bridge, forge queue and model map (default ~/Developer/omega).
OMEGA_DIR=
# Omega loop engine URL (default http://127.0.0.1:4780).
OMEGA_URL=
# Omega passcode sent as x-omega-key. If empty, Hermes reads OMEGA_KEY from $OMEGA_DIR/.env.local.
OMEGA_KEY=
# Folder holding bin/ffmpeg and whisper.cpp for voice notes (default ~/Developer/tools).
HERMES_TOOLS_DIR=
# LaunchAgent label link.sh restarts after pairing.
HERMES_LAUNCHD_LABEL=
